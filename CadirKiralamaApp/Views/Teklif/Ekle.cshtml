@model CadirKiralamaApp.Models.Teklif

@{
    bool isEdit = Model != null && Model.Id > 0;
    ViewData["Title"] = isEdit ? "Teklif Düzenle" : "Yeni Teklif Oluştur";
}

<style>
    ::-webkit-scrollbar {
        width: 6px;
        height: 6px;
    }

    ::-webkit-scrollbar-track {
        background: #f1f1f1;
    }

    ::-webkit-scrollbar-thumb {
        background: #cbd5e1;
        border-radius: 10px;
    }

        ::-webkit-scrollbar-thumb:hover {
            background: #94a3b8;
        }
</style>

<form asp-action="Kaydet" asp-controller="Teklif" method="post" id="teklifForm" class="bg-white rounded-lg shadow-sm border border-slate-200 flex flex-col overflow-hidden min-h-[85vh]">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />

    <!-- STICKY HEADER & AKSİYON BARI -->
    <header class="bg-white border-b border-slate-200 shadow-sm sticky top-0 z-30">
        <div class="px-6 py-4 flex flex-col md:flex-row justify-between items-center gap-4">

            <!-- Sol: Geri Dön & Breadcrumb & Başlık -->
            <div class="flex items-center gap-4">
                <a asp-action="Index" class="p-2.5 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-lg transition flex items-center gap-2 font-semibold text-sm">
                    <i class="fas fa-arrow-left"></i>
                    <span>Geri Dön</span>
                </a>
                <div class="h-8 w-px bg-slate-200"></div>
                <div>
                    <nav class="text-xs font-semibold text-slate-400 mb-0.5 flex items-center gap-2">
                        <a asp-action="Index" class="hover:text-primary transition">Teklif Yönetimi</a>
                        <i class="fas fa-chevron-right text-[10px]"></i>
                        <span class="text-primary">@(isEdit ? "Teklif Düzenle" : "Yeni Teklif")</span>
                    </nav>
                    <h1 class="text-xl font-bold text-dark flex items-center gap-2">
                        <i class="fas fa-file-invoice-dollar text-secondary"></i>
                        @(isEdit ? "Teklif Düzenleniyor (#" + Model?.TeklifNo + ")" : "Yeni Teklif Hazırlanıyor")
                    </h1>
                </div>
            </div>

            <!-- Sağ: İşlem Butonları -->
            <div class="flex items-center gap-2">
                <button type="button" onclick="showToast('PDF Ön İzleme modülü hazırlanıyor.', 'info')" class="p-2 text-slate-500 hover:text-primary hover:bg-slate-100 rounded transition" title="PDF Ön İzleme"><i class="fas fa-eye text-lg"></i></button>
                <button type="button" onclick="showToast('Teklif kopyalama özelliği hazırlanıyor.', 'info')" class="p-2 text-slate-500 hover:text-primary hover:bg-slate-100 rounded transition" title="Teklifi Kopyala"><i class="fas fa-copy text-lg"></i></button>
                <button type="button" onclick="showToast('Yazdırma özelliği yakında eklenecektir.', 'info')" class="p-2 text-slate-500 hover:text-primary hover:bg-slate-100 rounded transition" title="Yazdır"><i class="fas fa-print text-lg"></i></button>

                <div class="w-px h-6 bg-slate-200 mx-2"></div>

                <button type="button" onclick="showToast('PDF oluşturma özelliği yakında aktif olacaktır.', 'warning')" class="bg-white border border-slate-300 text-slate-700 hover:bg-slate-50 px-4 py-2 rounded-lg text-sm font-semibold shadow-sm transition flex items-center gap-2">
                    <i class="fas fa-file-pdf text-red-500"></i> PDF Oluştur
                </button>
                <button type="submit" class="bg-primary hover:bg-blue-900 text-white px-6 py-2 rounded-lg text-sm font-semibold shadow-md transition flex items-center gap-2">
                    <i class="fas fa-save"></i> Teklifi Kaydet
                </button>
            </div>
        </div>
    </header>

    <!-- ANA İÇERİK -->
    <div class="flex-1 overflow-y-auto p-6 bg-slate-50/50">
        <div class="max-w-[1500px] mx-auto space-y-6 pb-20">

            <!-- 1. KART: TEKLİF BİLGİLERİ -->
            <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-6">
                <h2 class="text-base font-bold text-primary mb-4 pb-2 border-b border-slate-100 flex items-center gap-2">
                    <i class="fas fa-info-circle text-secondary"></i> 1. Teklif ve Müşteri Bilgileri
                </h2>

                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5">
                    <div>
                        <label class="block text-xs font-bold text-slate-500 uppercase mb-1">Teklif No</label>
                        <input type="text" asp-for="TeklifNo" readonly class="w-full p-2.5 bg-slate-100 border border-slate-200 rounded-lg text-sm font-bold text-primary outline-none">
                    </div>

                    <div>
                        <label class="block text-xs font-bold text-slate-500 uppercase mb-1">Cari / Müşteri Firma</label>
                        <select asp-for="CariId" asp-items="ViewBag.Cariler" class="w-full p-2.5 bg-slate-50 border border-slate-200 rounded-lg focus:bg-white focus:border-secondary focus:ring-2 focus:ring-secondary/20 outline-none transition text-sm">
                            <option value="">-- Firma Seçiniz --</option>
                        </select>
                    </div>

                    <div>
                        <label class="block text-xs font-bold text-slate-500 uppercase mb-1">Teklif Tarihi</label>
                        <input type="date" asp-for="TeklifTarihi" class="w-full p-2.5 bg-slate-50 border border-slate-200 rounded-lg focus:bg-white focus:border-secondary focus:ring-2 focus:ring-secondary/20 outline-none transition text-sm">
                    </div>

                    <div>
                        <label class="block text-xs font-bold text-slate-500 uppercase mb-1">Teklif Tipi</label>
                        <select asp-for="TeklifinTipi" id="teklifTipi" onchange="generateSubject()" class="w-full p-2.5 bg-slate-50 border border-slate-200 rounded-lg focus:bg-white focus:border-secondary focus:ring-2 focus:ring-secondary/20 outline-none transition text-sm">
                            <option value="Kiralama">Kiralama</option>
                            <option value="Satış">Satış</option>
                        </select>
                    </div>

                    <div>
                        <label class="block text-xs font-bold text-slate-500 uppercase mb-1">Geçerlilik (Gün)</label>
                        <input type="number" asp-for="GecerlilikSuresiGun" class="w-full p-2.5 bg-slate-50 border border-slate-200 rounded-lg focus:bg-white focus:border-secondary text-sm outline-none">
                    </div>

                    <div class="lg:col-span-3">
                        <label class="block text-xs font-bold text-slate-500 uppercase mb-1">Teklif Konusu</label>
                        <input type="text" asp-for="TeklifKonusu" id="teklifKonusu" placeholder="Örn: Etkinlik Çadırı Kiralama Teklifi" class="w-full p-2.5 bg-slate-50 border border-slate-200 rounded-lg focus:bg-white focus:border-secondary outline-none transition text-sm font-semibold text-primary">
                    </div>

                    <div>
                        <label class="block text-xs font-bold text-slate-500 uppercase mb-1">Bizden İlgili</label>
                        <input type="text" asp-for="BizdenIlgili" class="w-full p-2.5 bg-slate-50 border border-slate-200 rounded-lg focus:bg-white focus:border-secondary text-sm outline-none">
                    </div>

                    <div>
                        <label class="block text-xs font-bold text-slate-500 uppercase mb-1">Firma İlgilisi / Yetkili</label>
                        <input type="text" asp-for="FirmaIlgilisi" placeholder="Örn: Ahmet Bey" class="w-full p-2.5 bg-slate-50 border border-slate-200 rounded-lg focus:bg-white focus:border-secondary text-sm outline-none">
                    </div>

                    <div>
                        <label class="block text-xs font-bold text-slate-500 uppercase mb-1">Ödeme Vadesi</label>
                        <input type="text" asp-for="OdemeVadesi" placeholder="Örn: Peşin / %50 Peşin" class="w-full p-2.5 bg-slate-50 border border-slate-200 rounded-lg focus:bg-white focus:border-secondary text-sm outline-none">
                    </div>

                    <div>
                        <label class="block text-xs font-bold text-slate-500 uppercase mb-1">Org. Başlangıç</label>
                        <input type="date" asp-for="OrgBaslangicTarihi" class="w-full p-2.5 bg-slate-50 border border-slate-200 rounded-lg text-sm outline-none">
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-slate-500 uppercase mb-1">Org. Bitiş</label>
                        <input type="date" asp-for="OrgBitisTarihi" class="w-full p-2.5 bg-slate-50 border border-slate-200 rounded-lg text-sm outline-none">
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-slate-500 uppercase mb-1">Montaj Tarihi</label>
                        <input type="date" asp-for="MontajTarihi" class="w-full p-2.5 bg-slate-50 border border-slate-200 rounded-lg text-sm outline-none">
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-slate-500 uppercase mb-1">Demontaj Tarihi</label>
                        <input type="date" asp-for="DemontajTarihi" class="w-full p-2.5 bg-slate-50 border border-slate-200 rounded-lg text-sm outline-none">
                    </div>

                    <div class="lg:col-span-4">
                        <label class="block text-xs font-bold text-slate-500 uppercase mb-1">Montaj / Kurulum Adresi</label>
                        <textarea asp-for="MontajAdresi" rows="2" placeholder="Montaj yapılacak açık adres detayları..." class="w-full p-2.5 bg-slate-50 border border-slate-200 rounded-lg focus:bg-white focus:border-secondary text-sm outline-none resize-none"></textarea>
                    </div>
                </div>
            </div>

            <!-- 2. KART: ÜRÜN VE HİZMET KALEMLERİ -->
            <div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
                <div class="p-5 border-b border-slate-100 flex flex-wrap justify-between items-center bg-slate-50/50 gap-3">
                    <h2 class="text-base font-bold text-primary flex items-center gap-2">
                        <i class="fas fa-boxes text-secondary"></i> 2. Ürün ve Hizmet Kalemleri
                    </h2>

                    <div class="flex items-center gap-2">
                        <button type="button" onclick="openUrunModal()" class="bg-emerald-600 hover:bg-emerald-700 text-white px-4 py-2 rounded-lg text-sm font-semibold shadow transition flex items-center gap-2">
                            <i class="fas fa-book-open"></i> Rehberden Ürün Seç
                        </button>
                        <button type="button" onclick="addEmptyRow()" class="bg-primary hover:bg-blue-800 text-white px-4 py-2 rounded-lg text-sm font-semibold shadow transition flex items-center gap-2">
                            <i class="fas fa-plus"></i> Boş Satır Ekle
                        </button>
                    </div>
                </div>

                <div class="overflow-x-auto">
                    <table class="w-full text-sm text-left">
                        <thead class="bg-slate-100 text-slate-500 uppercase text-[11px] font-bold tracking-wider">
                            <tr>
                                <th class="p-3 w-1/4">Ürün / Hizmet Adı</th>
                                <th class="p-3 w-1/6">Açıklama</th>
                                <th class="p-3 w-16 text-center">En(m)</th>
                                <th class="p-3 w-16 text-center">Boy(m)</th>
                                <th class="p-3 w-16 text-center">m²</th>
                                <th class="p-3 w-20">Birim</th>
                                <th class="p-3 w-20 text-center">Miktar</th>
                                <th class="p-3 w-28 text-right">Birim Fiyat</th>
                                <th class="p-3 w-16 text-center">İnd%</th>
                                <th class="p-3 w-16 text-center">KDV%</th>
                                <th class="p-3 w-28 text-right">Toplam</th>
                                <th class="p-3 w-12 text-center"><i class="fas fa-cog"></i></th>
                            </tr>
                        </thead>
                        <tbody id="urunTablosu" class="divide-y divide-slate-100">
                            @if (Model?.TeklifKalemleri != null && Model.TeklifKalemleri.Count > 0)
                            {
                                for (int i = 0; i < Model.TeklifKalemleri.Count; i++)
                                {
                                    <tr class="hover:bg-slate-50 transition group" data-index="@i">
                                        <td class="p-2">
                                            <input type="hidden" name="TeklifKalemleri[@i].Id" value="@Model.TeklifKalemleri[i].Id" />
                                            <input type="text" name="TeklifKalemleri[@i].UrunAdi" value="@Model.TeklifKalemleri[i].UrunAdi" class="w-full p-2 bg-transparent border border-transparent group-hover:border-slate-200 rounded focus:border-secondary outline-none font-semibold text-sm">
                                        </td>
                                        <td class="p-2"><input type="text" name="TeklifKalemleri[@i].Aciklama" value="@Model.TeklifKalemleri[i].Aciklama" class="w-full p-2 bg-transparent border border-transparent group-hover:border-slate-200 rounded focus:border-secondary outline-none text-xs text-slate-500"></td>
                                        <td class="p-2"><input type="number" step="0.01" name="TeklifKalemleri[@i].En" value="@Model.TeklifKalemleri[i].En" onchange="calcRow(this)" class="w-full p-1.5 bg-transparent border border-transparent group-hover:border-slate-200 rounded outline-none text-center text-xs"></td>
                                        <td class="p-2"><input type="number" step="0.01" name="TeklifKalemleri[@i].Boy" value="@Model.TeklifKalemleri[i].Boy" onchange="calcRow(this)" class="w-full p-1.5 bg-transparent border border-transparent group-hover:border-slate-200 rounded outline-none text-center text-xs"></td>
                                        <td class="p-2"><input type="number" step="0.01" name="TeklifKalemleri[@i].M2" value="@Model.TeklifKalemleri[i].M2" class="w-full p-1.5 bg-slate-100 rounded text-center text-xs font-semibold" readonly></td>
                                        <td class="p-2">
                                            <select name="TeklifKalemleri[@i].Birim" class="w-full p-1.5 bg-transparent border border-transparent group-hover:border-slate-200 rounded outline-none text-xs">
                                                @if (Model.TeklifKalemleri[i].Birim == "m²")
                                                {
                                                    <option value="m²" selected>m²</option>
                                                }
                                                else
                                                {
                                                    <option value="m²">m²</option>
                                                }
                                                @if (Model.TeklifKalemleri[i].Birim == "Adet")
                                                {
                                                    <option value="Adet" selected>Adet</option>
                                                }
                                                else
                                                {
                                                    <option value="Adet">Adet</option>
                                                }
                                                @if (Model.TeklifKalemleri[i].Birim == "Gün")
                                                {
                                                    <option value="Gün" selected>Gün</option>
                                                }
                                                else
                                                {
                                                    <option value="Gün">Gün</option>
                                                }
                                                @if (Model.TeklifKalemleri[i].Birim == "Set")
                                                {
                                                    <option value="Set" selected>Set</option>
                                                }
                                                else
                                                {
                                                    <option value="Set">Set</option>
                                                }
                                            </select>
                                        </td>
                                        <td class="p-2"><input type="number" step="1" name="TeklifKalemleri[@i].Miktar" value="@Model.TeklifKalemleri[i].Miktar" onchange="calcRow(this)" class="w-full p-2 bg-transparent border border-transparent group-hover:border-slate-200 rounded text-center font-semibold outline-none text-sm"></td>
                                        <td class="p-2"><input type="number" step="0.01" name="TeklifKalemleri[@i].Fiyat" value="@Model.TeklifKalemleri[i].Fiyat" onchange="calcRow(this)" class="w-full p-2 bg-transparent border border-transparent group-hover:border-slate-200 rounded text-right font-semibold outline-none text-sm"></td>
                                        <td class="p-2"><input type="number" step="1" name="TeklifKalemleri[@i].IndirimOrani" value="@Model.TeklifKalemleri[i].IndirimOrani" onchange="calcRow(this)" class="w-full p-1.5 bg-transparent border border-transparent group-hover:border-slate-200 rounded text-center outline-none text-xs"></td>
                                        <td class="p-2">
                                            <select name="TeklifKalemleri[@i].KdvOrani" onchange="calcRow(this)" class="w-full p-1.5 bg-transparent border border-transparent group-hover:border-slate-200 rounded outline-none text-xs">
                                                @if (Model.TeklifKalemleri[i].KdvOrani == 20)
                                                {
                                                    <option value="20" selected>20</option>
                                                }
                                                else
                                                {
                                                    <option value="20">20</option>
                                                }
                                                @if (Model.TeklifKalemleri[i].KdvOrani == 10)
                                                {
                                                    <option value="10" selected>10</option>
                                                }
                                                else
                                                {
                                                    <option value="10">10</option>
                                                }
                                                @if (Model.TeklifKalemleri[i].KdvOrani == 0)
                                                {
                                                    <option value="0" selected>0</option>
                                                }
                                                else
                                                {
                                                    <option value="0">0</option>
                                                }
                                            </select>
                                        </td>
                                        <td class="p-2 text-right font-bold text-primary row-total">0,00 ₺</td>
                                        <td class="p-2 text-center">
                                            <button type="button" class="text-slate-400 hover:text-red-500 transition" onclick="removeRow(this)"><i class="fas fa-trash"></i></button>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Alt Toplam Özeti -->
                <div class="bg-slate-50 p-6 flex flex-col items-end border-t border-slate-200">
                    <div class="w-full md:w-80 space-y-2">
                        <div class="flex justify-between text-sm text-slate-500">
                            <span>Ara Toplam:</span>
                            <span id="lblAraToplam" class="font-semibold text-dark">0,00 ₺</span>
                        </div>
                        <div class="flex justify-between text-sm text-slate-500">
                            <span>İndirim Toplamı:</span>
                            <span id="lblIndirimToplam" class="font-semibold text-red-500">- 0,00 ₺</span>
                        </div>
                        <div class="flex justify-between text-sm text-slate-500">
                            <span>KDV Toplamı:</span>
                            <span id="lblKdvToplam" class="font-semibold text-dark">0,00 ₺</span>
                        </div>
                        <div class="pt-3 border-t border-slate-200 flex justify-between items-center">
                            <span class="font-bold text-primary text-base">Genel Toplam:</span>
                            <span id="lblGenelToplam" class="font-extrabold text-primary text-xl">0,00 ₺</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 3. KART: TEKLİF METNİ VE ŞARTLAR -->
            <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-6">
                <h2 class="text-base font-bold text-primary mb-4 flex items-center gap-2">
                    <i class="fas fa-align-left text-secondary"></i> 3. Teklif Metni ve Özel Şartlar
                </h2>

                <textarea asp-for="TeklifMetni" rows="6" class="w-full p-4 border border-slate-200 rounded-lg text-sm text-slate-700 outline-none focus:border-secondary transition" placeholder="Teklif alt metnini ve şartları yazabilirsiniz..."></textarea>
            </div>

        </div>
    </div>
</form>

<!-- REHBERDEN ÜRÜN SEÇME MODAL -->
<div id="urunModal" class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm z-50 flex items-center justify-center hidden">
    <div class="bg-white w-full max-w-3xl rounded-xl shadow-2xl overflow-hidden flex flex-col max-h-[80vh]">
        <div class="p-4 bg-primary text-white flex justify-between items-center">
            <h3 class="font-bold text-base flex items-center gap-2">
                <i class="fas fa-boxes"></i> Ürün / Hizmet Rehberi
            </h3>
            <button type="button" onclick="closeUrunModal()" class="text-white/80 hover:text-white text-lg"><i class="fas fa-times"></i></button>
        </div>

        <div class="p-4 border-b border-slate-100 bg-slate-50">
            <input type="text" id="modalSearch" onkeyup="filterUrunModal()" placeholder="Ürün adı veya koduna göre ara..." class="w-full p-2.5 border border-slate-200 rounded-lg text-sm outline-none focus:border-secondary">
        </div>

        <div class="p-4 overflow-y-auto flex-1">
            <table class="w-full text-sm text-left">
                <thead class="bg-slate-100 text-slate-500 uppercase text-[11px] font-bold">
                    <tr>
                        <th class="p-3">Ürün Kodu</th>
                        <th class="p-3">Ürün / Hizmet Adı</th>
                        <th class="p-3 text-right">İşlem</th>
                    </tr>
                </thead>
                <tbody id="modalUrunListesi" class="divide-y divide-slate-100">
                    <!-- JS ile dolacak -->
                </tbody>
            </table>
        </div>

        <div class="p-4 bg-slate-50 border-t border-slate-200 flex justify-end">
            <button type="button" onclick="closeUrunModal()" class="px-4 py-2 bg-slate-200 hover:bg-slate-300 text-slate-700 text-sm font-semibold rounded-lg transition">Kapat</button>
        </div>
    </div>
</div>

<!-- TOAST BİLDİRİM KONTEYNERİ -->
<div id="toast-container" class="fixed bottom-5 right-5 z-50 flex flex-col gap-3"></div>

@section Scripts {
    <script>
        let rowIndex = parseInt("@(Model?.TeklifKalemleri?.Count ?? 0)") || 0;

        document.addEventListener('DOMContentLoaded', () => {
            if (rowIndex === 0) {
                addEmptyRow();
            } else {
                calculateAll();
            }
        });

        function addEmptyRow(urunAdi = '', aciklama = '', birim = 'm²', miktar = 1, fiyat = 0) {
            const tbody = document.getElementById('urunTablosu');
            if (!tbody) return;

            const tr = document.createElement('tr');
            tr.className = "hover:bg-slate-50 transition group";
            tr.setAttribute('data-index', rowIndex);

            tr.innerHTML = `
                        <td class="p-2">
                            <input type="hidden" name="TeklifKalemleri[${rowIndex}].Id" value="0" />
                            <input type="text" name="TeklifKalemleri[${rowIndex}].UrunAdi" value="${urunAdi}" placeholder="Ürün adı yazın..." class="w-full p-2 bg-transparent border border-transparent group-hover:border-slate-200 rounded focus:border-secondary outline-none font-semibold text-sm">
                        </td>
                        <td class="p-2"><input type="text" name="TeklifKalemleri[${rowIndex}].Aciklama" value="${aciklama}" placeholder="Açıklama..." class="w-full p-2 bg-transparent border border-transparent group-hover:border-slate-200 rounded focus:border-secondary outline-none text-xs text-slate-500"></td>
                        <td class="p-2"><input type="number" step="0.01" name="TeklifKalemleri[${rowIndex}].En" value="0" onchange="calcRow(this)" class="w-full p-1.5 bg-transparent border border-transparent group-hover:border-slate-200 rounded outline-none text-center text-xs"></td>
                        <td class="p-2"><input type="number" step="0.01" name="TeklifKalemleri[${rowIndex}].Boy" value="0" onchange="calcRow(this)" class="w-full p-1.5 bg-transparent border border-transparent group-hover:border-slate-200 rounded outline-none text-center text-xs"></td>
                        <td class="p-2"><input type="number" step="0.01" name="TeklifKalemleri[${rowIndex}].M2" value="0" class="w-full p-1.5 bg-slate-100 rounded text-center text-xs font-semibold" readonly></td>
                        <td class="p-2">
                            <select name="TeklifKalemleri[${rowIndex}].Birim" class="w-full p-1.5 bg-transparent border border-transparent group-hover:border-slate-200 rounded outline-none text-xs">
                                <option value="m²" ${birim === 'm²' ? 'selected' : ''}>m²</option>
                                <option value="Adet" ${birim === 'Adet' ? 'selected' : ''}>Adet</option>
                                <option value="Gün" ${birim === 'Gün' ? 'selected' : ''}>Gün</option>
                                <option value="Set" ${birim === 'Set' ? 'selected' : ''}>Set</option>
                            </select>
                        </td>
                        <td class="p-2"><input type="number" step="1" name="TeklifKalemleri[${rowIndex}].Miktar" value="${miktar}" onchange="calcRow(this)" class="w-full p-2 bg-transparent border border-transparent group-hover:border-slate-200 rounded text-center font-semibold outline-none text-sm"></td>
                        <td class="p-2"><input type="number" step="0.01" name="TeklifKalemleri[${rowIndex}].Fiyat" value="${fiyat}" onchange="calcRow(this)" class="w-full p-2 bg-transparent border border-transparent group-hover:border-slate-200 rounded text-right font-semibold outline-none text-sm"></td>
                        <td class="p-2"><input type="number" step="1" name="TeklifKalemleri[${rowIndex}].IndirimOrani" value="0" onchange="calcRow(this)" class="w-full p-1.5 bg-transparent border border-transparent group-hover:border-slate-200 rounded text-center outline-none text-xs"></td>
                        <td class="p-2">
                            <select name="TeklifKalemleri[${rowIndex}].KdvOrani" onchange="calcRow(this)" class="w-full p-1.5 bg-transparent border border-transparent group-hover:border-slate-200 rounded outline-none text-xs">
                                <option value="20">20</option>
                                <option value="10">10</option>
                                <option value="0">0</option>
                            </select>
                        </td>
                        <td class="p-2 text-right font-bold text-primary row-total">0,00 ₺</td>
                        <td class="p-2 text-center">
                            <button type="button" class="text-slate-400 hover:text-red-500 transition" onclick="removeRow(this)"><i class="fas fa-trash"></i></button>
                        </td>
                    `;

            tbody.appendChild(tr);
            rowIndex++;
            calculateAll();
        }

        function removeRow(btn) {
            const tr = btn.closest('tr');
            if (tr) tr.remove();
            calculateAll();
        }

        function calcRow(element) {
            const tr = element.closest('tr');
            if (!tr) return;

            const en = parseFloat(tr.querySelector('[name*=".En"]')?.value) || 0;
            const boy = parseFloat(tr.querySelector('[name*=".Boy"]')?.value) || 0;
            const m2Input = tr.querySelector('[name*=".M2"]');

            if (m2Input) {
                let m2 = en * boy;
                m2Input.value = m2.toFixed(2);
            }

            calculateAll();
        }

        function calculateAll() {
            let araToplam = 0;
            let indirimToplam = 0;
            let kdvToplam = 0;

            document.querySelectorAll('#urunTablosu tr').forEach(tr => {
                const miktar = parseFloat(tr.querySelector('[name*=".Miktar"]')?.value) || 0;
                const birimFiyat = parseFloat(tr.querySelector('[name*=".Fiyat"]')?.value) || 0;
                const indirimOrani = parseFloat(tr.querySelector('[name*=".IndirimOrani"]')?.value) || 0;
                const kdvOrani = parseFloat(tr.querySelector('[name*=".KdvOrani"]')?.value) || 0;

                const hamTutar = miktar * birimFiyat;
                const indirimTutari = hamTutar * (indirimOrani / 100);
                const netTutar = hamTutar - indirimTutari;
                const kdvTutari = netTutar * (kdvOrani / 100);
                const satirToplam = netTutar + kdvTutari;

                const rowTotalSpan = tr.querySelector('.row-total');
                if (rowTotalSpan) {
                    rowTotalSpan.textContent = satirToplam.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' ₺';
                }

                araToplam += hamTutar;
                indirimToplam += indirimTutari;
                kdvToplam += kdvTutari;
            });

            const genelToplam = (araToplam - indirimToplam) + kdvToplam;

            const lblAra = document.getElementById('lblAraToplam');
            const lblInd = document.getElementById('lblIndirimToplam');
            const lblKdv = document.getElementById('lblKdvToplam');
            const lblGen = document.getElementById('lblGenelToplam');

            if (lblAra) lblAra.textContent = araToplam.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' ₺';
            if (lblInd) lblInd.textContent = '- ' + indirimToplam.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' ₺';
            if (lblKdv) lblKdv.textContent = kdvToplam.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' ₺';
            if (lblGen) lblGen.textContent = genelToplam.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' ₺';
        }

        function generateSubject() {
            const tipi = document.getElementById('teklifTipi')?.value || '';
            const konuInput = document.getElementById('teklifKonusu');
            if (konuInput && !konuInput.value.trim()) {
                konuInput.value = `${tipi} Teklifi`;
            }
        }

        function openUrunModal() {
            document.getElementById('urunModal')?.classList.remove('hidden');
            loadUrunler();
        }

        function closeUrunModal() {
            document.getElementById('urunModal')?.classList.add('hidden');
        }

        function filterUrunModal() {
            const filter = document.getElementById('modalSearch').value.toLowerCase();
            const rows = document.querySelectorAll('#modalUrunListesi tr');
            rows.forEach(row => {
                const text = row.innerText.toLowerCase();
                row.style.display = text.includes(filter) ? '' : 'none';
            });
        }

        function loadUrunler() {
            const tbody = document.getElementById('modalUrunListesi');
            if (!tbody) return;

            tbody.innerHTML = '<tr><td colspan="3" class="p-4 text-center text-slate-400">Yükleniyor...</td></tr>';

            fetch('/Teklif/GetUrunlerJson')
                .then(res => res.json())
                .then(data => {
                    tbody.innerHTML = '';
                    if (!data || data.length === 0) {
                        tbody.innerHTML = '<tr><td colspan="3" class="p-4 text-center text-slate-400">Kayıtlı ürün bulunamadı.</td></tr>';
                        return;
                    }
                    data.forEach(u => {
                        const tr = document.createElement('tr');
                        tr.className = "hover:bg-slate-50 transition border-b border-slate-100";

                        const urunAdiSafe = (u.urunAdi || 'İsimsiz Ürün').replace(/'/g, "\\'").replace(/"/g, '&quot;');
                        const aciklamaSafe = (u.aciklama || '').replace(/'/g, "\\'").replace(/"/g, '&quot;'); // Açıklama eklendi
                        const birimSafe = (u.birim || 'm²').replace(/'/g, "\\'");
                        const fiyat = u.fiyat || 0;

                        tr.innerHTML = `
                                    <td class="p-3 font-mono text-xs text-slate-500">${u.kod || '-'}</td>
                                    <td class="p-3 font-semibold text-slate-700">
                                        ${u.urunAdi || 'İsimsiz Ürün'}
                                        ${u.aciklama ? `<div class="text-xs text-slate-400 font-normal mt-0.5">${u.aciklama}</div>` : ''}
                                    </td>
                                    <td class="p-3 text-right">
                                        <button type="button" onclick="selectUrun('${urunAdiSafe}', '${aciklamaSafe}', '${birimSafe}', ${fiyat})" class="bg-primary hover:bg-blue-800 text-white px-3 py-1 rounded text-xs transition">Seç</button>
                                    </td>
                                `;
                        tbody.appendChild(tr);
                    });
                })
                .catch(err => {
                    console.error("Ürün yükleme hatası:", err);
                    tbody.innerHTML = '<tr><td colspan="3" class="p-4 text-center text-rose-500 font-semibold">Ürünler yüklenirken sunucu hatası oluştu.</td></tr>';
                });
        }

        function selectUrun(ad, aciklama, birim, fiyat) {
            addEmptyRow(ad, aciklama, birim, 1, fiyat);
            closeUrunModal();
            showToast(`"${ad}" teklife eklendi.`, 'success');
        }

        function showToast(message, type = 'info') {
            const container = document.getElementById('toast-container');
            if (!container) return;

            const toast = document.createElement('div');
            let bgClass = "bg-slate-800 text-white";
            if (type === 'success') bgClass = "bg-emerald-600 text-white";
            if (type === 'warning') bgClass = "bg-amber-500 text-white";
            if (type === 'error') bgClass = "bg-rose-600 text-white";

            toast.className = `${bgClass} px-4 py-3 rounded-lg shadow-lg text-sm flex items-center justify-between gap-4 min-w-[280px] transition-all duration-300 transform translate-y-2 opacity-0`;
            toast.innerHTML = `
                        <span>${message}</span>
                        <button onclick="this.parentElement.remove()" class="text-white/80 hover:text-white"><i class="fas fa-times"></i></button>
                    `;

            container.appendChild(toast);

            setTimeout(() => {
                toast.classList.remove('translate-y-2', 'opacity-0');
            }, 10);

            setTimeout(() => {
                toast.classList.add('opacity-0', 'translate-y-2');
                setTimeout(() => toast.remove(), 300);
            }, 4000);
        }
    </script>
}